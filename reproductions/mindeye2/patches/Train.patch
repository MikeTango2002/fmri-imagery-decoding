+# [grad-accum] Who is allowed to advance the LR scheduler?
+# accelerate wraps it on prepare(), and WHICH wrapper you get decides the answer:
+#   * DeepSpeedSchedulerWrapper.step() is a no-op -- the DeepSpeed engine steps the scheduler
+#     itself, once per optimizer update;
+#   * AcceleratedScheduler.step() steps the underlying scheduler num_processes times per call
+#     (it assumes one dataloader batch per process per call), and only when sync_gradients.
+# Either way calling `lr_scheduler.step()` once per micro-step -- what upstream does -- is
+# wrong as soon as grad_accum_steps > 1, and under the second wrapper it is wrong already at
+# gas=1 (2 processes = the OneCycleLR horizon consumed at twice the rate, so the cycle ends at
+# epoch 75 of 150 and the rest of the run trains at max_lr/1000). Both failures are silent.
+# So: hold the RAW torch scheduler, and step it exactly once per update, iff nobody else did.
+raw_lr_scheduler = getattr(lr_scheduler, "scheduler", lr_scheduler)
+sched_seen = getattr(raw_lr_scheduler, "_step_count", 0)
+sched_stepped_by_us = 0
+num_updates = 0
+
+def step_lr_scheduler():
+    global sched_seen, sched_stepped_by_us
+    count = getattr(raw_lr_scheduler, "_step_count", 0)
+    if count == sched_seen: # nobody advanced it since our last call -> it is on us
+        raw_lr_scheduler.step()
+        sched_stepped_by_us += 1
+    sched_seen = getattr(raw_lr_scheduler, "_step_count", 0)
+
+print("lr scheduler wrapper:", type(lr_scheduler).__name__, "-> raw:", type(raw_lr_scheduler).__name__)
+print("optimizer wrapper:", type(optimizer).__name__)
