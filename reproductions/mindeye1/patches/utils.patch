+    # Here a window of candidates is fetched concurrently, but the `num` kept
+    # are still selected in LAION rank order -- not "the first ones to arrive" --
+    # so the images finally returned are the ones the sequential code would
+    # have returned. The candidate URLs point at third-party web hosts, not at
+    # knn.laion.ai, so this concurrency does not add load to LAION's service.
+    def _fetch_one(res):
+        # Define a User-Agent header to mimic a web browser, then load the image
