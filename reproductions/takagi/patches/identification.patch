 import argparse
+import csv
+import os
+import time
 import numpy as np
 from tqdm import tqdm
 
+CSV_FIELDS = ['subject', 'method', 'usefeat', 'nimage', 'acc', 'acc_sem',
+              'acc_per_image', 'timestamp']
+# Column order of Table 1 in the technical report, so the CSV can be read side by side.
+FEAT_ORDER = ['inception', 'alexnet5', 'alexnet12', 'alexnet18',
+              'clip', 'clip_h6', 'clip_h12']
+
+def save_results(outpath, subject, method, usefeat, nimage, acc_mean, acc_sem, acc_all):
+    """Persist the accuracy next to the printed line. Purely additive: nothing here
+    touches the numbers computed above, it only writes them where a later run can read
+    them back. The row key is (subject, method, usefeat, nimage), so re-evaluating the
+    same configuration overwrites its own row instead of piling up duplicates."""
+    outdir = os.path.dirname(os.path.abspath(outpath))
+    os.makedirs(outdir, exist_ok=True)
+
+    accname = f'acc_{method}_{subject}_{usefeat}_n{nimage}.npy'
+    np.save(f'{outdir}/{accname}', acc_all)
+
+    row = {
+        'subject': subject,
+        'method': method,
+        'usefeat': usefeat,
+        'nimage': str(nimage),
+        'acc': f'{acc_mean:.06f}',
+        'acc_sem': f'{acc_sem:.06f}',
+        'acc_per_image': accname,
+        'timestamp': time.strftime('%Y-%m-%d %H:%M:%S'),
+    }
+
+    rows = []
+    if os.path.exists(outpath):
+        with open(outpath, newline='') as f:
+            for old in csv.DictReader(f):
+                same = (old.get('subject') == row['subject']
+                        and old.get('method') == row['method']
+                        and old.get('usefeat') == row['usefeat']
+                        and old.get('nimage') == row['nimage'])
+                if not same:
+                    rows.append(old)
+    rows.append(row)
+
+    def sortkey(r):
+        feat = r.get('usefeat', '')
+        rank = FEAT_ORDER.index(feat) if feat in FEAT_ORDER else len(FEAT_ORDER)
+        return (r.get('method', ''), r.get('subject', ''), rank, feat)
+
+    rows.sort(key=sortkey)
+
+    with open(outpath, 'w', newline='') as f:
+        writer = csv.DictWriter(f, fieldnames=CSV_FIELDS, restval='',
+                                extrasaction='ignore')
+        writer.writeheader()
+        writer.writerows(rows)
+
+    print(f'saved {outpath} ({len(rows)} rows) and {accname}')
+
 def load_feat_org(imgid, subject, method, usefeat):
