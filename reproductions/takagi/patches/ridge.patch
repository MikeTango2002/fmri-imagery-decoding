+# ---------------------------------------------------------------------------
+# Progress logging (local addition, numerically inert).
+# Upstream prints nothing between the start of pipeline.fit() and its end, so a
+# multi-minute run looks dead: under `nohup ... > log` stdout is block-buffered
+# (the fd is a file, not a tty), so even the surrounding prints only reach the
+# log when the process exits. Everything below writes to stdout only -- alphas,
+# pipeline, solver and data are untouched.
+# ---------------------------------------------------------------------------
+
+_T0 = time.time()
+HEARTBEAT_SEC = float(os.environ.get('RIDGE_HEARTBEAT_SEC', 60))
+
+
+def log(msg):
+    """Timestamped log line, flushed immediately so a redirected log stays live."""
+    print(f'[{time.strftime("%H:%M:%S")} +{time.time() - _T0:7.1f}s] {msg}', flush=True)
+
+
+def rss_gb():
+    """Resident memory of this process, read from /proc (no psutil dependency)."""
+    try:
+        with open('/proc/self/statm') as f:
+            pages = int(f.read().split()[1])
+        return pages * os.sysconf('SC_PAGE_SIZE') / 2 ** 30
+    except OSError:
+        return float('nan')
+
+
+class Heartbeat:
+    """Print a keep-alive line every HEARTBEAT_SEC while a blocking call runs.
+
+    himalaya's SVD solver exposes no progress callback, so this is the only way
+    to tell a live fit from a hung one without patching the library.
+    """
+
+    def __init__(self, label, period=HEARTBEAT_SEC):
+        self.label = label
+        self.period = period
+        self._stop = threading.Event()
+        self._thread = threading.Thread(target=self._run, daemon=True)
+
+    def _run(self):
+        t0 = time.time()
+        while not self._stop.wait(self.period):
+            log(f'  ... {self.label} running: {time.time() - t0:.0f}s elapsed, RSS {rss_gb():.1f} GB')
+
+    def __enter__(self):
+        if self.period > 0:
+            self._thread.start()
+        return self
+
+    def __exit__(self, *exc):
+        self._stop.set()
+        if self._thread.is_alive():
+            self._thread.join(timeout=1.0)
+        return False
+
+
+def load(path):
+    """np.load(...).astype(float32) plus a log line with shape and size."""
+    log(f'loading {path}')
+    arr = np.load(path).astype("float32")
+    log(f'  -> shape {arr.shape}, {arr.nbytes / 2 ** 30:.2f} GB, RSS {rss_gb():.1f} GB')
+    return arr
+
+
+def save_weights(path, scaler, ridge, X_te, scores, **meta):
+    """Persist the fitted decoder so it can be applied to betas this run never saw.
+
+    Upstream only saves `scores`, i.e. the predictions on the 982 shared1000 test
+    images: the fitted pipeline dies with the process, so decoding any other betas
+    (NSD-Imagery) would require refitting. We write the two things a forward pass
+    needs -- the StandardScaler statistics and the ridge coefficients -- as a plain
+    .npz, deliberately not a pickle of the sklearn/himalaya objects, so loading it
+    later does not depend on those library versions still being installed.
+
+    Inference is then, with the ROIs hstacked in the order recorded in `roi`:
+        w = np.load(path)
+        pred = ((X - w['scaler_mean']) / w['scaler_scale']) @ w['coef'] + w['intercept']
+    """
+    coef = np.asarray(ridge.coef_)
+    n_features = scaler.mean_.shape[0]
+    if coef.shape[0] != n_features and coef.shape[1] == n_features:
+        # himalaya stores (n_features, n_targets); tolerate the other orientation.
+        log(f'  coef_ is {coef.shape}, transposing to match {n_features} features')
+        coef = coef.T
+    intercept = np.asarray(getattr(ridge, 'intercept_', np.float32(0.0)))
+
+    # Self-check: the arrays we are about to write must reproduce pipeline.predict()
+    # on the test set. If they do not, inference from disk would silently diverge
+    # from what this run just scored, which is exactly the failure we cannot afford.
+    manual = ((X_te - scaler.mean_) / scaler.scale_) @ coef + intercept
+    maxdiff = float(np.abs(manual - scores).max())
+    log(f'  weights self-check: max |from-disk - pipeline.predict| = {maxdiff:.3e}')
+    if not np.allclose(manual, scores, atol=1e-3, rtol=1e-3):
+        log('  WARNING: reconstructed predictions differ from pipeline.predict() -- '
+            'do NOT use these weights for inference before understanding why')
+
+    np.savez(path,
+             coef=coef.astype(np.float32),
+             intercept=intercept.astype(np.float32),
+             scaler_mean=scaler.mean_.astype(np.float32),
+             scaler_scale=scaler.scale_.astype(np.float32),
+             best_alphas=np.asarray(getattr(ridge, 'best_alphas_', [])),
+             selfcheck_maxdiff=np.float64(maxdiff),
+             roi=np.asarray(meta['roi']),
+             roi_sizes=np.asarray(meta['roi_sizes']),
+             subject=np.asarray(meta['subject']),
+             target=np.asarray(meta['target']),
+             alphas=np.asarray(meta['alphas']))
+    log(f'saved {path} ({os.path.getsize(path) / 2 ** 30:.2f} GB), coef {coef.shape}')
+
+
