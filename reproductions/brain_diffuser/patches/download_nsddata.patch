+    os.system('aws s3 cp --no-sign-request s3://natural-scenes-dataset/nsddata/ppdata/subj{:02d}/func1pt8mm/roi/nsdgeneral.nii.gz nsddata/ppdata/subj{:02d}/func1pt8mm/roi/'.format(sub,sub))
